      "inputSchema": {
        "type": "object",
        "properties": {
          "path": { "type": "string", "format": "path", "description": "Absolute path of the directory." }
        },
        "required": ["path"],
        "additionalProperties": false
      },
      "annotations": { "readOnlyHint": true, "destructiveHint": false, "openWorldHint": false }
    },
    {
      "name": "stat_path",
      "description": "Return metadata for a path: size, modification time, and permissions. Read-only.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": { "type": "string", "format": "path", "description": "Path to inspect." }
